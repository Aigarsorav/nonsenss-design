<!doctype html>
<html lang="{{ settings.language or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ settings.siteTitle }}</title>
  <meta name="description" content="{{ settings.siteDescription }}">
  <meta name="theme-color" content="#0f1012">
  <link rel="canonical" href="{{ settings.siteUrl }}/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ header.logoText }} {{ header.logoSubtext }}">
  <meta property="og:title" content="{{ settings.siteTitle }}">
  <meta property="og:description" content="{{ settings.siteDescription }}">
  <meta property="og:url" content="{{ settings.siteUrl }}/">
  {% if settings.shareImage %}
  <meta property="og:image" content="{{ settings.siteUrl }}{{ settings.shareImage | shareImage }}">
  <meta name="twitter:card" content="summary_large_image">
  {% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/main.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {{ content | safe }}
</body>
</html>
