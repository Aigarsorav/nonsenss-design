{% set s = t.settings %}
{% set pageTitle = s.siteName ~ (' — ' ~ s.siteTitle if s.siteTitle else '') %}
{% set favicon = t.header.favicon | brandImage %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ s.siteDescription }}">
  <meta name="theme-color" content="#0f1012">
  <link rel="canonical" href="{{ s.siteUrl }}{{ locale.url }}">
  {% for l in locales %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ s.siteUrl }}{{ l.url }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ s.siteUrl }}/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ s.siteName }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ s.siteDescription }}">
  <meta property="og:url" content="{{ s.siteUrl }}{{ locale.url }}">
  <meta property="og:locale" content="{{ { en: 'en_GB', et: 'et_EE', ru: 'ru_RU' }[lang] }}">
  {% if s.shareImage %}
  <meta property="og:image" content="{{ s.siteUrl }}{{ s.shareImage | shareImage }}">
  <meta name="twitter:card" content="summary_large_image">
  {% endif %}
  {% if favicon %}
  <link rel="icon" href="{{ favicon.url }}" type="{{ favicon.type }}">
  {% else %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;500;700&display=swap">
  {% if lang == "ru" %}
  {# Archivo has no Cyrillic; Roboto Flex has the same width axis and takes over headings on the Russian page. #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,100..151,600..800&display=swap">
  {% endif %}
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/main.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">{{ t.header.skipLink }}</a>
  {{ content | safe }}
</body>
</html>
