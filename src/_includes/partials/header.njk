<header class="site-header" data-header>
  <div class="progress" aria-hidden="true"><div class="progress__bar" data-progress></div></div>
  <div class="site-header__bar">
    <div class="container site-header__inner">
      <a href="#top" class="logo">
        <span class="logo__text">{{ header.logoText }}</span>
        <span class="logo__sub">{{ header.logoSubtext }}</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#work" class="nav__link">{{ header.nav.work }}</a>
        <a href="#services" class="nav__link">{{ header.nav.services }}</a>
        <a href="#process" class="nav__link">{{ header.nav.process }}</a>
        <a href="#studio" class="nav__link">{{ header.nav.studio }}</a>
        <a href="#quote" class="btn btn--primary btn--nav">{{ header.buttonText }}</a>
      </nav>
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu"
        aria-label="{{ header.openMenuLabel }}" data-label-open="{{ header.openMenuLabel }}" data-label-close="{{ header.closeMenuLabel }}">
        <svg class="menu-toggle__open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg class="menu-toggle__close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="mobile-menu__nav container" aria-label="Mobile">
      <a href="#work" class="mobile-menu__link">{{ header.nav.work }}</a>
      <a href="#services" class="mobile-menu__link">{{ header.nav.services }}</a>
      <a href="#process" class="mobile-menu__link">{{ header.nav.process }}</a>
      <a href="#studio" class="mobile-menu__link">{{ header.nav.studio }}</a>
      <a href="#quote" class="mobile-menu__cta">{{ header.buttonText }}</a>
    </nav>
  </div>
</header>
