{% set h = t.header %}
{# Logo modes: text (default) · logo · both. Without a usable image every mode falls back to text. #}
{% set logo = h.logoImage | brandImage %}
{% set logoMode = h.logoDisplay if logo and h.logoDisplay in ["logo", "both"] else "text" %}
{% macro langSwitch(class) %}
<nav class="lang {{ class }}" aria-label="{{ h.languageLabel }}">
  {% for l in locales %}
  <a href="{{ l.url }}" class="lang__link" lang="{{ l.code }}" hreflang="{{ l.code }}" title="{{ l.name }}"{% if l.code == lang %} aria-current="page"{% endif %}>{{ l.label }}</a>
  {% endfor %}
</nav>
{% endmacro %}
<header class="site-header" data-header>
  <div class="progress" aria-hidden="true"><div class="progress__bar" data-progress></div></div>
  <div class="site-header__bar">
    <div class="container site-header__inner">
      <a href="{{ locale.url }}#top" class="logo logo--{{ logoMode }}">
        {% if logoMode != "text" %}
        {# Next to the text logo the image is decorative; on its own it carries the name. #}
        <img class="logo__img" src="{{ logo.url }}" width="{{ logo.width }}" height="{{ logo.height }}" alt="{{ h.logoAlt if logoMode == 'logo' else '' }}" decoding="async">
        {% endif %}
        {% if logoMode != "logo" %}
        <span class="logo__words">
          <span class="logo__text">{{ h.logoText }}</span>
          <span class="logo__sub">{{ h.logoSubtext }}</span>
        </span>
        {% endif %}
      </a>
      <nav class="nav" aria-label="{{ h.mainNavLabel }}">
        <a href="#work" class="nav__link">{{ h.nav.work }}</a>
        <a href="#services" class="nav__link">{{ h.nav.services }}</a>
        <a href="#process" class="nav__link">{{ h.nav.process }}</a>
        <a href="#studio" class="nav__link">{{ h.nav.studio }}</a>
        {{ langSwitch("lang--nav") }}
        <a href="#quote" class="btn btn--primary btn--nav">{{ h.buttonText }}</a>
      </nav>
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu"
        aria-label="{{ h.openMenuLabel }}" data-label-open="{{ h.openMenuLabel }}" data-label-close="{{ h.closeMenuLabel }}">
        <svg class="menu-toggle__open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg class="menu-toggle__close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="mobile-menu__nav container" aria-label="{{ h.mainNavLabel }}">
      <a href="#work" class="mobile-menu__link">{{ h.nav.work }}</a>
      <a href="#services" class="mobile-menu__link">{{ h.nav.services }}</a>
      <a href="#process" class="mobile-menu__link">{{ h.nav.process }}</a>
      <a href="#studio" class="mobile-menu__link">{{ h.nav.studio }}</a>
      <a href="#quote" class="mobile-menu__cta">{{ h.buttonText }}</a>
      {{ langSwitch("lang--menu") }}
    </nav>
  </div>
</header>
