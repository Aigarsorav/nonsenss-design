<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="{{ t.work.galleryLabel }}" hidden>
  <div class="lightbox__top">
    <p class="lightbox__caption" data-lb-caption></p>
    <p class="lightbox__counter" data-lb-counter aria-live="polite"></p>
    <button type="button" class="lightbox__btn lightbox__close" data-lb-close aria-label="{{ t.work.closeLabel }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="lightbox__stage" data-lb-stage>
    <img class="lightbox__img" data-lb-img alt="" decoding="async">
    <span class="lightbox__loader" aria-hidden="true"></span>
  </div>
  <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="{{ t.work.previousLabel }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
  </button>
  <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next aria-label="{{ t.work.nextLabel }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  </button>
</div>
