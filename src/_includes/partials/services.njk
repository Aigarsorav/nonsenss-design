<section id="services" class="band">
  <div class="container section services">
    <div class="services__intro">
      <div class="eyebrow">
        <span class="eyebrow__line"></span>
        <span class="label-tech">{{ t.services.label }}</span>
      </div>
      <h2 class="h2">{{ t.services.headline | lines }}</h2>
      <p class="services__text">{{ t.services.text }}</p>
    </div>
    <ol class="services__list">
      {% for service in t.services.services %}
      <li class="service">
        <div class="service__head">
          <span class="num">{{ loop.index | pad2 }}</span>
          <h3 class="service__title">{{ service.title }}</h3>
        </div>
        <p class="service__desc">{{ service.description }}</p>
        {% if service.tags and service.tags.length %}
        <ul class="service__tags">
          {% for tag in service.tags %}<li class="tag">{{ tag }}</li>{% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
