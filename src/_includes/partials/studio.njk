<section id="studio" class="band">
  <div class="container section studio">
    <figure class="studio__media">
      {{ t.studio.image | picture(t.studio.imageAlt, "(min-width: 1024px) 640px, 100vw", { class: "studio__img" }) }}
      <div class="studio__shade" aria-hidden="true"></div>
      {% if t.studio.imageCaption %}<figcaption class="studio__caption">{{ t.studio.imageCaption }}</figcaption>{% endif %}
    </figure>
    <div>
      <div class="eyebrow">
        <span class="eyebrow__line"></span>
        <span class="label-tech">{{ t.studio.label }}</span>
      </div>
      <h2 class="h2">{{ t.studio.headline | lines }}</h2>
      <p class="studio__text">{{ t.studio.text }}</p>
      {% if t.studio.textSecondary %}<p class="studio__text studio__text--muted">{{ t.studio.textSecondary }}</p>{% endif %}
      {% if t.studio.stats and t.studio.stats.length %}
      <ul class="stats">
        {% for stat in t.studio.stats %}
        <li>
          <p class="stats__value">{{ stat.value }}</p>
          <p class="stats__label">{{ stat.label }}</p>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>
